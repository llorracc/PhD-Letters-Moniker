% Colors used in subfiles
\definecolor{darkblue}{rgb}{0.1,0.094,0.3}
\definecolor{darkred}{rgb}{0.3,0,0}
\hypersetup{colorlinks=true,linkcolor=darkblue,urlcolor=darkblue,citecolor=darkblue}

% Lists that stay inside the text margin
\usepackage{enumitem}
