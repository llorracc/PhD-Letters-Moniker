\input{\latexroot/@local/econtex_notinsubfile}

% Bibliography style
\providecommand{\econtexBibStyle}{\latexroot/@local/texlive/texmf-local/bibtex/bst/econtex}

\KOMAoptions{addrfield=false,backaddress=false}
% Margins for US letter paper; enlargefirstpage allows more content on page 1
\KOMAoptions{DIV=12,enlargefirstpage=true}

% Keyname for paper
\newcommand{\texname}{Letter}

% Packages
\usepackage{graphicx}
\usepackage{amsmath,amsfonts,amssymb}
\usepackage{booktabs,multirow,threeparttable,dcolumn,array,multicol}
