\usepackage[hyphens]{url}
\usepackage{hyperref}
\usepackage{xr-hyper}  % cross-references between documents (\externaldocument in subfiles)
\usepackage{scrlayer-scrpage}
\usepackage{catchfile}  % reads the Name-Of-*.tex files
% Minimal thebibliography stub so natbib can renew it under scrlttr2
\makeatletter
\providecommand\bibname{References}
\providecommand\@biblabel[1]{[#1]}
\newenvironment{thebibliography}[1]{\section*{\bibname}\begin{list}{\@biblabel{\arabic{enumi}}}{\usecounter{enumi}}}{\end{list}}
\makeatother
\usepackage[authoryear,round]{natbib}
\renewcommand{\bibsection}{\par\bigskip\noindent\textbf{\large References}\par\medskip}
\usepackage{ifthen}
