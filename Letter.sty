\setlist[enumerate]{leftmargin=3em,itemsep=0.3em,parsep=0pt,topsep=0.5em}

\usepackage{microtype}
\usepackage{needspace}

% Compat for subfile-only macros used in content
\newboolean{Web}\setboolean{Web}{false}
\newboolean{showPageHead}\setboolean{showPageHead}{false}

% ═══════════════════════════════════════════════════════════════════════════
% \whenstandalone{...} runs only when a subfile is compiled on its own;
% \whenintegrated{...} runs only when it is part of Letter.tex.
% ═══════════════════════════════════════════════════════════════════════════
\makeatletter
\newcommand{\whenintegrated}[1]{\@ifundefined{entrypoint}{}{#1}}
\newcommand{\whenstandalone}[1]{\@ifundefined{entrypoint}{#1}{}}
\@ifclassloaded{subfiles}{}{\newcommand{\entrypoint}{true}}
\makeatother
\providecommand{\notinsubfile}[1]{\whenintegrated{#1}}
\providecommand{\onlyinsubfile}[1]{\whenstandalone{#1}}

% ═══════════════════════════════════════════════════════════════════════════
% THE ADVISOR'S PASSAGES
% ═══════════════════════════════════════════════════════════════════════════
% The advisor's own paragraphs (his judgments) live in a private folder that
% the student never sees, beside this repository:
%     ../PhD-RecLetters-private/saynicethings/<name>.tex
% \cdcinsert{<name>}{<what goes here>} marks where one of them belongs.
%
% - In the student's builds, and in any build of this repository by itself, a
%   red [CDC: <what goes here>] marker shows the place. Nothing private is read.
% - Only the advisor's build script reads the private folder. It builds in a
%   throwaway copy and creates cdc-build.flag there; the private folder merely
%   sitting next to this repository is NOT enough. That way no PDF built in
%   this repository can ever contain the advisor's text.
% - The script's final build also creates cdc-final.flag, which removes the
%   red markers. \cdctodo{...} stays red in every build, so nothing unsettled
%   goes out unnoticed.
\newif\ifCDCBuild \CDCBuildfalse
\IfFileExists{\latexroot/cdc-build.flag}{\CDCBuildtrue}{}
\newif\ifCDCFinal \CDCFinalfalse
\IfFileExists{\latexroot/cdc-final.flag}{\CDCFinaltrue}{}
\newcommand{\saynicethings}{\latexroot/../PhD-RecLetters-private/saynicethings}
\newcommand{\cdcmarker}[1]{\ifCDCFinal\else\textcolor{red}{[CDC: #1]}\fi}
\newcommand{\cdctodo}[1]{\textcolor{red}{[CDC TODO: #1]}}
\newcommand{\cdcinsert}[2]{%
  \ifCDCBuild
    \IfFileExists{\saynicethings/#1.tex}%
      {\input{\saynicethings/#1.tex}}%
      {\cdcmarker{#2 (saynicethings/#1.tex)}}%
  \else
    \cdcmarker{#2}%
  \fi}

% Section headings in a letter class; keep each heading with its first paragraph
\providecommand{\section}[1]{\par\Needspace{4\baselineskip}\vspace{0.6\baselineskip}\noindent\textbf{#1}\par\smallskip\nopagebreak}
\providecommand{\minisec}[1]{\par\Needspace{3\baselineskip}\vspace{0.4\baselineskip}\noindent\textbf{#1}\par\smallskip\nopagebreak}
\providecommand{\newblock}{}

% ═══════════════════════════════════════════════════════════════════════════
% BIBLIOGRAPHY
% ═══════════════════════════════════════════════════════════════════════════
% The student's references go in Letter.bib, the only bibliography file the
% student's builds read. (The advisor's build may add cdc-references.bib for
% works his own passages cite.) The References section prints only when the
% letter cites something: a letter with no \cite gets no empty heading and no
% BibTeX error.
\newif\ifLetterHasCitations \LetterHasCitationsfalse
\makeatletter
\def\citation#1{\global\LetterHasCitationstrue}  % \citation lines in the .aux from the previous run
\@ifclassloaded{subfiles}{}{\bibliographystyle{\econtexBibStyle}}
\makeatother
\newcommand{\LetterReferences}{%
  \ifLetterHasCitations
    \clearpage
    \IfFileExists{\latexroot/cdc-references.bib}%
      {\bibliography{\latexroot/Letter,\latexroot/cdc-references}}%
      {\bibliography{\latexroot/Letter}}%
  \fi}

% \LetterIfEmpty{\macro}{if empty}{if not}: true when \macro expands to nothing
\newcommand{\LetterIfEmpty}[3]{\if\relax\detokenize\expandafter{#1}\relax #2\else #3\fi}

% ═══════════════════════════════════════════════════════════════════════════
% LETTERHEAD, TITLE, SIGNATURE
% ═══════════════════════════════════════════════════════════════════════════
% The advisor's details: advisor-macros.ltx. Paths to the logo and signature
% images: advisor-local.ltx, which only the advisor's build supplies.
\input{\latexroot/advisor-macros.ltx}
\InputIfFileExists{\latexroot/advisor-local.ltx}{}{}

\setkomavar{fromname}{\AdvisorLetterheadName}
\setkomavar{fromaddress}{\AdvisorKOMAAddress}
\setkomavar{firsthead}{}
\setplength{sigbeforevskip}{0.5\baselineskip}

\newcommand{\LetterLogo}{%
  \LetterIfEmpty{\AdvisorLogoFile}{}{%
    \IfFileExists{\AdvisorLogoFile}{\begin{center}\includegraphics[height=0.75in]{\AdvisorLogoFile}\end{center}}{}}}

\setkomavar{signature}{%
  \LetterIfEmpty{\AdvisorSignatureFile}{}{%
    \IfFileExists{\AdvisorSignatureFile}{\includegraphics[height=0.5in]{\AdvisorSignatureFile}\\}{}}%
  \AdvisorSignatureName\\
  \AdvisorLetterheadLineOne, \AdvisorInstitution}
\renewcommand*{\raggedsignature}{\raggedright}

% Destination: Name-Of-*.tex. In the advisor's build these come from his
% destination folder; a file holding only a comment counts as empty.
\newcommand{\LetterReadName}[2]{%
  \IfFileExists{\latexroot/#2}{\CatchFileDef{#1}{\latexroot/#2}{\endlinechar=-1 }}{\def#1{}}}
\LetterReadName{\NameOfProgram}{Name-Of-Program.tex}
\LetterReadName{\NameOfPosition}{Name-Of-Position.tex}
\LetterReadName{\NameOfDepartment}{Name-Of-Department.tex}
\LetterReadName{\NameOfEmployer}{Name-Of-Employer.tex}

% "Recommendation of <name>", then the destination: the program if one is
% named, otherwise position, department and employer, each on its own line.
\newcommand{\LetterTitleBlock}{%
  \begin{center}
    \textbf{Recommendation of \FullName}%
    \LetterIfEmpty{\NameOfProgram}{%
      \LetterIfEmpty{\NameOfPosition}{}{\\ for \NameOfPosition}%
      \LetterIfEmpty{\NameOfDepartment}{}{\\ \NameOfDepartment}%
      \LetterIfEmpty{\NameOfEmployer}{}{\\ \NameOfEmployer}%
    }{\\ for the \NameOfProgram}%
  \end{center}}

% Page number: bottom right, number only
\clearpairofpagestyles
\ofoot{\pagemark}
\cfoot{}
\renewcommand*\pagemark{\usekomafont{pagenumber}\thepage}
\pagestyle{scrheadings}
