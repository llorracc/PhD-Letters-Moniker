% -*- mode: LaTeX; TeX-PDF-mode: t; -*-
% Paths for a build from this folder: every .tex file's folder has a file of this name.
% When Letter.tex includes a section (Letter.sty then defines \entrypoint), the root's paths stand.
\ifdefined\entrypoint\else
  \def\latexroot{..}          % the repository's root is one level up
  \def\projectname{Letter}    % the main document, ../Letter.tex
  % Where LaTeX looks for Letter.sty and student-macros.ltx: the root, and .letter/ there
  \makeatletter\def\input@path{{../}{../.letter/}}\makeatother
\fi
