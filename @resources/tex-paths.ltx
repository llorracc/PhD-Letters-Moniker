% -*- mode: LaTeX; TeX-PDF-mode: t; -*-
% Consolidated LaTeX Path Configuration (Single Source of Truth)
%
% This file provides package search paths (\input@path) for LaTeX to find custom packages
%
% Usage: \input{\latexroot/@resources/tex-paths}
%
% Based on HAFiscal-Latest architecture

\makeatletter
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
% SECTION 1: Package Search Paths
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
% Add directories to the search path for .sty, .cls, .bst, and .bib files
%
% IMPORTANT: \input@path does NOT support recursive search (// notation doesn't work)
% Each subdirectory must be listed explicitly for \RequirePackage to find packages
%
% Paths are listed for multiple directory levels to support compilation from:
%   - Project root (PhD-RecLetters-shared/)
%   - Subdirectories (PhD-RecLetters-shared/Subfiles/)

% ============================================================================
% ROOT LEVEL (when compiling from project root)
% ============================================================================
\def\input@path{
  % @resources directories (shared resources)
  {@resources/texlive/texmf-local/tex/latex/}%
  ,{@resources/texlive/texmf-local/bibtex/bst/}%
  ,{@resources/texlive/texmf-local/bibtex/bib/}%
  % @local directories (project-specific)
  ,{@local/}%
  ,{@local/texlive/texmf-local/tex/latex/}%
  ,{@local/texlive/texmf-local/bibtex/bst/}%
  ,{@local/texlive/texmf-local/bibtex/bib/}%
  % Package subdirectories (explicit paths for each package)
  ,{@local/texlive/texmf-local/tex/latex/tex4ht/}%
  %
  % ============================================================================
  % ONE LEVEL UP (when compiling from Subfiles/)
  % ============================================================================
  ,{../@resources/texlive/texmf-local/tex/latex/}%
  ,{../@resources/texlive/texmf-local/bibtex/bst/}%
  ,{../@resources/texlive/texmf-local/bibtex/bib/}%
  ,{../@local/}%
  ,{../@local/texlive/texmf-local/tex/latex/}%
  ,{../@local/texlive/texmf-local/bibtex/bst/}%
  ,{../@local/texlive/texmf-local/bibtex/bib/}%
  ,{../@local/texlive/texmf-local/tex/latex/tex4ht/}%
  ,{../}%
  %
  % ============================================================================
  % TWO LEVELS UP (when compiling from deeper subdirectories)
  % ============================================================================
  ,{../../@resources/texlive/texmf-local/tex/latex/}%
  ,{../../@resources/texlive/texmf-local/bibtex/bst/}%
  ,{../../@resources/texlive/texmf-local/bibtex/bib/}%
  ,{../../@local/}%
  ,{../../@local/texlive/texmf-local/tex/latex/}%
  ,{../../@local/texlive/texmf-local/bibtex/bst/}%
  ,{../../@local/texlive/texmf-local/bibtex/bib/}%
  ,{../../@local/texlive/texmf-local/tex/latex/tex4ht/}%
  ,{../../}%
}

\makeatother

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
% SECTION 2: Backward Compatibility Macros
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
% Define old macro names for backward compatibility during migration

\providecommand{\LaTeXInputs}{\latexroot/@local}
\providecommand{\econtexRoot}{\latexroot}

